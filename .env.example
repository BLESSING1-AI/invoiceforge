# Optional — real LLM extraction (falls back to rule-based)
AI_PROVIDER=openai
AI_API_KEY=

# Email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM="InvoiceForge <onboarding@resend.dev>"

# Postgres / Supabase (required for production multi-instance persistence)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Set to false only for local Postgres without SSL
DATABASE_SSL=true

# Optional Supabase client (not required when using DATABASE_URL + pg)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
